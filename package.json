{
  "name": "engineering-agents",
  "version": "0.1.0",
  "description": "Agents that automate an engineer's daily loop: work item -> plan -> code -> merge request, and log signal -> root cause -> fix -> merge request.",
  "license": "MIT",
  "type": "module",
  "engines": { "node": ">=20" },
  "bin": { "eng-agents": "./dist/cli.js" },
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx src/cli.ts",
    "test": "vitest run",
    "lint": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "yaml": "^2.5.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.5.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "optionalDependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.1.0"
  }
}
