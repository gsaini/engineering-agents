# Model access. The Claude Agent SDK also accepts an `ant auth login` profile,
# in which case this can be left unset.
ANTHROPIC_API_KEY=

# Azure DevOps — scopes: Work Items (Read & Write), Code (Read & Write)
AZURE_DEVOPS_PAT=

# Jira Cloud
JIRA_EMAIL=
JIRA_API_TOKEN=

# Application Insights
APPINSIGHTS_APP_ID=
APPINSIGHTS_API_KEY=

# AWS CloudWatch Logs — standard credential chain also works
AWS_REGION=eu-west-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Splunk
SPLUNK_TOKEN=

# GitHub — scopes: repo
GITHUB_TOKEN=

# Slack
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=

# Emergency stop: set to 1 to halt all watchers
KILL_SWITCH=0
